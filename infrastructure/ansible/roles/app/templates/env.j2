# {{ ansible_managed }}
{% set db = lookup('amazon.aws.secretsmanager_secret', db_secret_arn, region=crate_region) | from_json %}
{% macro quoted(value) %}'{{ value | replace("'", "\\'") }}'{% endmacro %}
SECRET_KEY={{ quoted(lookup('amazon.aws.ssm_parameter', parameter_path ~ '/SECRET_KEY', region=crate_region)) }}
ADMIN_EMAIL={{ quoted(lookup('amazon.aws.ssm_parameter', parameter_path ~ '/ADMIN_EMAIL', region=crate_region)) }}
ADMIN_PASSWORD={{ quoted(lookup('amazon.aws.ssm_parameter', parameter_path ~ '/ADMIN_PASSWORD', region=crate_region)) }}
DATABASE_URL={{ quoted('postgresql+psycopg://' ~ db_user ~ ':' ~ (db.password | urlencode | replace('/', '%2F')) ~ '@' ~ db_host ~ ':5432/' ~ db_name ~ '?sslmode=require') }}
PICTURE_STORAGE=s3
PICTURE_BUCKET={{ picture_bucket }}
AWS_DEFAULT_REGION={{ crate_region }}
