# Copy to .env and fill in. .env is never committed.

# At least 32 characters. Generate one with: openssl rand -hex 32
SECRET_KEY=

# The first admin, created on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database password for docker compose
POSTGRES_PASSWORD=

# Optional: keep picture files in a private S3 bucket instead of the database. Do not put AWS keys here;
# on EC2 the server's role provides them.
# PICTURE_STORAGE=s3
# PICTURE_BUCKET=
# AWS_DEFAULT_REGION=us-east-1
